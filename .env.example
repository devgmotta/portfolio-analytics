# URL canônica do site (usada em metadata, sitemap, robots, OG). Sem essa
# env var, cai no fallback de lib/site.ts (domínio .vercel.app do projeto).
NEXT_PUBLIC_SITE_URL=

# ID de medição do GA4 (formato "G-XXXXXXX"). Sem essa env var, o componente
# <GoogleAnalytics> não é renderizado (app/layout.tsx) — não quebra o build.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Chave da API do Resend, usada pela Server Action de contato
# (app/actions/contact.ts). Sem essa env var, o formulário retorna um erro
# tratado ("não configurado") em vez de tentar chamar a API e quebrar.
RESEND_API_KEY=
